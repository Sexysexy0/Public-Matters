// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "./OperatorPrivileges.sol";
import "./AIDecisionAudit.sol";
import "./BudgetDeliberationRegistry.sol";

/**
 * @title BudgetAuditIntegrator
 * @notice Bridges BudgetDeliberationRegistry to AIDecisionAudit.
 *
 * Access model: ANY registered operator may audit budget events.
 * There is no single "authority" address — leadership is a role,
 * not a bottleneck. Rotating, adding, or removing operators is
 * handled entirely by OperatorPrivileges.
 *
 * For every budget lifecycle event, this integrator writes an
 * immutable decision record into AIDecisionAudit. Result:
 *   - Every budget decision has a supersedable audit trail
 *   - Every disbursement has a verifiable hash chain
 *   - Every rejection is preserved (never hidden)
 */
contract BudgetAuditIntegrator {

    OperatorPrivileges public immutable privileges;
    AIDecisionAudit public immutable audit;
    BudgetDeliberationRegistry public immutable budget;

    uint256 public totalAudited;

    event BudgetEventAudited(
        bytes32 indexed proposalId,
        bytes32 indexed decisionId,
        string eventType,
        uint8 confidence,
        address indexed operator
    );

    modifier onlyOperator() {
        require(privileges.isOperator(msg.sender), "Not an operator");
        _;
    }

    constructor(
        address _privileges,
        address _audit,
        address _budget
    ) {
        require(_privileges != address(0), "privileges=0");
        require(_audit      != address(0), "audit=0");
        require(_budget     != address(0), "budget=0");

        privileges = OperatorPrivileges(_privileges);
        audit      = AIDecisionAudit(_audit);
        budget     = BudgetDeliberationRegistry(_budget);
    }

    /**
     * @notice Audit a budget proposal event into AIDecisionAudit.
     * @param proposalId The ID in BudgetDeliberationRegistry.
     * @param eventType  "PROPOSED" | "DELIBERATING" | "APPROVED" |
     *                   "REJECTED" | "DISBURSING" | "COMPLETED" | "AUDITED".
     * @param confidence 0-100 (e.g. votesFor / totalVotes * 100).
     */
    function auditBudgetEvent(
        bytes32 proposalId,
        string calldata eventType,
        uint8 confidence
    ) external onlyOperator returns (bytes32) {
        require(confidence <= 100, "Confidence must be 0-100");

        BudgetDeliberationRegistry.Proposal memory p = budget.getProposal(proposalId);

        bytes32 inputHash = keccak256(abi.encodePacked(
            p.title, p.category, p.amount, p.proposer, p.createdAt
        ));

        bytes32 reasoningHash = keccak256(abi.encodePacked(
            p.votesFor, p.votesAgainst, p.deliberationHash
        ));

        bytes32 outputHash = keccak256(abi.encodePacked(
            eventType, uint256(p.stage), p.disbursedAmount, p.auditHash
        ));

        bytes32 agentId = keccak256(abi.encodePacked("BUDGET", address(budget)));

        bytes32 decisionId = audit.recordDecision(
            agentId, inputHash, reasoningHash, outputHash, confidence
        );

        totalAudited++;

        emit BudgetEventAudited(proposalId, decisionId, eventType, confidence, msg.sender);
        return decisionId;
    }

    /**
     * @notice One-shot audit of the current lifecycle state.
     * @dev Idempotent — safe to call repeatedly to re-anchor state.
     */
    function auditFullLifecycle(bytes32 proposalId)
        external onlyOperator returns (bytes32)
    {
        BudgetDeliberationRegistry.Proposal memory p = budget.getProposal(proposalId);

        uint8 confidence = 0;
        uint256 total = p.votesFor + p.votesAgainst;
        if (total > 0) {
            confidence = uint8((p.votesFor * 100) / total);
        }

        return _record(proposalId, _stageName(p.stage), confidence, p);
    }

    function _record(
        bytes32 proposalId,
        string memory eventType,
        uint8 confidence,
        BudgetDeliberationRegistry.Proposal memory p
    ) internal returns (bytes32) {
        bytes32 inputHash = keccak256(abi.encodePacked(
            p.title, p.category, p.amount, p.proposer, p.createdAt
        ));
        bytes32 reasoningHash = keccak256(abi.encodePacked(
            p.votesFor, p.votesAgainst, p.deliberationHash
        ));
        bytes32 outputHash = keccak256(abi.encodePacked(
            eventType, uint256(p.stage), p.disbursedAmount, p.auditHash
        ));
        bytes32 agentId = keccak256(abi.encodePacked("BUDGET", address(budget)));

        bytes32 decisionId = audit.recordDecision(
            agentId, inputHash, reasoningHash, outputHash, confidence
        );
        totalAudited++;
        emit BudgetEventAudited(proposalId, decisionId, eventType, confidence, msg.sender);
        return decisionId;
    }

    function _stageName(BudgetDeliberationRegistry.Stage s)
        internal pure returns (string memory)
    {
        if (s == BudgetDeliberationRegistry.Stage.PROPOSED)      return "PROPOSED";
        if (s == BudgetDeliberationRegistry.Stage.DELIBERATING)  return "DELIBERATING";
        if (s == BudgetDeliberationRegistry.Stage.APPROVED)      return "APPROVED";
        if (s == BudgetDeliberationRegistry.Stage.REJECTED)      return "REJECTED";
        if (s == BudgetDeliberationRegistry.Stage.DISBURSING)    return "DISBURSING";
        if (s == BudgetDeliberationRegistry.Stage.COMPLETED)     return "COMPLETED";
        if (s == BudgetDeliberationRegistry.Stage.AUDITED)       return "AUDITED";
        return "UNKNOWN";
    }

    // ── Public read helpers ─────────────────────────────────────

    function getBudgetAuditTrail() external view returns (bytes32[] memory) {
        bytes32 agentId = keccak256(abi.encodePacked("BUDGET", address(budget)));
        return audit.getDecisionsByAgent(agentId);
    }

    function getBudgetAuditCount() external view returns (uint256) {
        bytes32 agentId = keccak256(abi.encodePacked("BUDGET", address(budget)));
        return audit.getDecisionCount(agentId);
    }
}
